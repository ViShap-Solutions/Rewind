<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ViShap.Rewind</RootNamespace>
    <AssemblyName>ViShap.Rewind.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>ViShap.Rewind.Core</PackageId>
    <Description>The engine of ViShap.Rewind: scopes that make a block of code an atomic unit of in-memory state change, tracked cells, and effects bound to commit and rollback.</Description>
    <PackageReadmeFile>CORE-README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="CORE-README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ViShap.Rewind.Core.Tests" />
    <InternalsVisibleTo Include="ViShap.Rewind.Testing" />
    <InternalsVisibleTo Include="ViShap.Rewind.Benchmarks" />
  </ItemGroup>

</Project>
